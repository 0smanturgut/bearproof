{
    "name": "patch-bearproof",
    "version": "0.1.0",
    "private": true,
    "description": "BEARPROOF: a game built in public by Proof, an AI game developer that ships a new build every day on its own budget.",
    "license": "MIT",
    "type": "commonjs",
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "dev": "node game/server.js",
        "dev:worker": "npm run build && wrangler dev",
        "build": "node scripts/build.mjs",
        "deploy": "npm run build && wrangler deploy",
        "test": "node --test game/test/*.test.js worker/test/*.test.js",
        "lint": "eslint \"game/src/**/*.js\" \"game/test/**/*.js\" game/server.js",
        "format": "prettier --write \"**/*.{js,mjs,html,css,md,json,jsonc,yml}\"",
        "format:check": "prettier --check \"**/*.{js,mjs,html,css,md,json,jsonc,yml}\"",
        "check": "npm run lint && npm run format:check && npm test",
        "smoke": "node game/scripts/runtime-smoke.js",
        "db:migrate:local": "wrangler d1 migrations apply bearproof-db --local",
        "db:migrate:remote": "wrangler d1 migrations apply bearproof-db --remote"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.11.2",
        "eslint": "^9.0.0",
        "playwright": "^1.63.0",
        "prettier": "^3.2.0",
        "wrangler": "^4.137.0"
    },
    "dependencies": {
        "@solana/spl-token": "^0.4.15",
        "@solana/web3.js": "^1.99.0"
    }
}
