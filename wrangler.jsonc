// Cloudflare Worker: serves the HQ, every immutable game build (/b/<n>/) and the API.
// Everything here is reproducible. Secrets are set with `wrangler secret put`, never in this file.
// See docs/SETUP.md.
{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "bearproof",
    "main": "worker/src/index.js",
    "compatibility_date": "2026-09-01",
    // Buffer and friends for @solana/web3.js (payouts only).
    "compatibility_flags": ["nodejs_compat"],
    "workers_dev": true,
    // The game and HQ live at https://bearproof.app (zone on this Cloudflare account). www redirects to the apex.
    "routes": [
        { "pattern": "bearproof.app", "custom_domain": true },
        { "pattern": "www.bearproof.app", "custom_domain": true }
    ],
    "preview_urls": false,
    "observability": { "enabled": true },
    // Every 15 minutes: fee snapshot, settle yesterday's Daily Challenge, resume a half-finished payout.
    "triggers": { "crons": ["*/15 * * * *"] },

    // Static assets are assembled by `npm run build` (scripts/build.mjs) into ./dist.
    // Only these paths run Worker code. Every other request is a free static hit.
    "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "not_found_handling": "404-page",
        "run_worker_first": ["/", "/play", "/play/*", "/api/*", "/run/*", "/og/*"]
    },

    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "bearproof-db",
            "database_id": "ae037dee-5017-4ffb-b905-25d5926a83f7",
            "migrations_dir": "worker/migrations"
        }
    ],

    // CONFIG holds operator switches: build_override (one-key revert), payouts_enabled (kill switch).
    "kv_namespaces": [{ "binding": "CONFIG", "id": "4f4fa4b95f1c4ddda0780c1f1ae1e53b" }],

    "ratelimits": [
        { "name": "RL_SUBMIT", "namespace_id": "7301", "simple": { "limit": 12, "period": 60 } },
        { "name": "RL_READ", "namespace_id": "7302", "simple": { "limit": 120, "period": 60 } }
    ],

    // Public, non-secret configuration. Empty string = not configured yet (the API reports that honestly).
    "vars": {
        "PROJECT_START_DATE": "2026-09-23",
        "ANSEM_MINT": "9cRCn9rGT8V2imeM2BaKs13yhMEais3ruM3rPvTGpump",
        "TOKEN_MINT": "6aktZWaJLQpe3sey13uCwAn7s977mhuKdbVHP8t7ttZX",
        // The ClawPump agent wallet: ClawPump forwards the agent's share of creator fees here.
        "TREASURY_WALLET": "GNJoHj9yfn3jqNNkC5ffQDaB5vTrnvVqy4FjQuXmBLS6",
        // pump.fun creator vault of the coin (PDA "creator-vault" + the creator DvJVRbuB…918c, a ClawPump-run wallet):
        // creator fees accrue here until ClawPump claims them and forwards the agent's share.
        "CREATOR_VAULT": "CGy3DDwzLERGkeeJRQ7perGaMbGtRNuRy8YZ755NuBpp",
        // The agent's share of creator fees on ClawPump (docs/TREASURY.md). Used to estimate unclaimed fees.
        "CREATOR_FEE_SHARE": "0.75",
        "PRIZE_WALLET": "GD9HPVpLqDxYfgf9ZNQDN3WwCfZips7tVCHAhMcchRo5",
        "CLAWPUMP_AGENT_ID": "",
        // The operator's wallet: it funded the agent wallet, and compute and hosting are paid back to it.
        "COSTS_WALLET": "5Em3PQsFrmFcNnZeQWwg51hq8N3CaYWL4SDKR92FZVv3",
        "TURNSTILE_SITE_KEY": "0x4AAAAAAFBfsyRdhquSMqN7",
        "REPO_URL": "https://github.com/0smanturgut/bearproof"
    }
}
